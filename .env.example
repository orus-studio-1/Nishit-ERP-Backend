DATABASE_URL="postgresql://postgres:password@localhost:5432/orus_erp?schema=public"
DB_POOL_MAX="5"
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_DAYS="3650"
AUTH_COOKIE_SAME_SITE="lax"
JWT_EXPIRES_IN="7d"
PORT=5000
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
CACHE_MEMORY_MAX_ITEMS=2000
REDIS_CONNECT_TIMEOUT_MS=1500
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="orus-erp"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
ENABLE_BACKGROUND_WORKER="true"
CRM_MESSAGE_GATEWAY_URL=""
CRM_MESSAGE_GATEWAY_TOKEN=""
# Optional channel-specific providers. If omitted, CRM_MESSAGE_GATEWAY_* is used.
SALES_EMAIL_GATEWAY_URL=""
SALES_WHATSAPP_GATEWAY_URL=""
SALES_MESSAGE_GATEWAY_TOKEN=""
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
CRM_MAIL_SYNC_URL=""
CRM_MAIL_SYNC_TOKEN=""
